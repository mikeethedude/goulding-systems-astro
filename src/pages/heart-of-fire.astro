---
// src/pages/heart-of-fire.astro
import BaseLayout from '../layouts/BaseLayout.astro'; // Adjust path as needed
---

<BaseLayout title="Heart of Fire Series | Michael Goulding" description="A stockroom worker turned walking natural disaster. The Heart of Fire sci-fi series.">
  
  {/* We wrap the whole page content in a dark slate/obsidian background to isolate the book's vibe from the main site's gradient */}
  <main class="bg-[#121212] text-gray-200 min-h-screen font-sans selection:bg-[#00E5FF] selection:text-black">
    
    {/* HERO SECTION */}
    <section class="relative flex flex-col items-center justify-center text-center pt-32 pb-20 px-6 overflow-hidden">
      {/* Optional: A subtle glowing gradient orb behind the text */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#FF4500] opacity-20 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="z-10 max-w-4xl mx-auto space-y-6">
        <p class="text-[#FF4500] font-bold tracking-widest uppercase text-sm md:text-base animate-pulse">
          The Heart of Fire Series is Here
        </p>
        
        <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight drop-shadow-lg">
          A Stockroom Worker Turned <br/> 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FF4500] to-yellow-500">
            Walking Natural Disaster.
          </span>
        </h1>
        
        <h2 class="text-2xl md:text-3xl text-gray-300 font-medium mt-4">
          An Empire Built on Mechanical Flesh. <br/>
          The Spark That Burns It All Down.
        </h2>

        <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mt-6">
          High-octane New Adult sci-fi/fantasy where ancient elemental power collides with corporate cybernetic horror.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
          <a href="#" class="px-8 py-4 bg-[#FF4500] hover:bg-orange-600 text-white font-bold rounded-md transition-all shadow-[0_0_15px_rgba(255,69,0,0.5)] hover:shadow-[0_0_25px_rgba(255,69,0,0.8)]">
            Buy Book 1 on Amazon
          </a>
          <a href="#book-2" class="px-8 py-4 bg-transparent border-2 border-[#00E5FF] text-[#00E5FF] hover:bg-[#00E5FF] hover:text-black font-bold rounded-md transition-all">
            Explore Book 2
          </a>
        </div>
      </div>
    </section>

    {/* BOOK 1 SPOTLIGHT */}
    <section class="max-w-6xl mx-auto px-6 py-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      {/* Cover Image Placeholder */}
      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-[#FF4500] to-[#00E5FF] rounded-lg blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
        <div class="relative aspect-[2/3] bg-gray-800 rounded-lg flex items-center justify-center border border-gray-700 shadow-2xl">
          <span class="text-gray-500">[ Ember in the Darkness Cover Render ]</span>
        </div>
      </div>

      <div class="space-y-6">
        <div class="inline-block px-3 py-1 bg-gray-800 border border-gray-700 rounded-full text-xs font-semibold text-gray-300 tracking-wide">
          Available Now in eBook, Paperback & Hardcover
        </div>
        
        <h3 class="text-4xl font-bold text-white">Ember in the Darkness</h3>
        
        <blockquote class="border-l-4 border-[#FF4500] pl-4 italic text-xl text-gray-300">
          "You didn't choose the fire. The fire chose you."
        </blockquote>

        <p class="text-gray-400 leading-relaxed">
          Locke was just trying to survive his shifts in the stockroom. But when a tragic awakening reveals a glowing red crystal buried over his heart, he learns two harrowing truths: his home wasn't destroyed by terrorists—it was incinerated by his own uncontrolled power—and the empire known as GEAR is coming for him.
        </p>

        <ul class="space-y-3 text-gray-300">
          <li><span class="text-[#00E5FF]">⚡ Fast-Paced Magic System:</span> Hard elemental powers paired with tactical sci-fi combat.</li>
          <li><span class="text-[#00E5FF]">🤖 Cybernetic Threat:</span> Brutal cyborg armies and bio-mechanical horrors.</li>
          <li><span class="text-[#00E5FF]">🤝 Found Family:</span> Snarky banter, fierce loyalty, and deep character bonds.</li>
        </ul>
      </div>
    </section>

  </main>
</BaseLayout>
      <style is:global>
  /* Nuke the green gradient and force the obsidian background just for this page */
  .backgrounds {
    background: #121212 !important;
    background-image: none !important;
  }
</style>

